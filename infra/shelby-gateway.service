[Unit]
Description=ShelbyHost artifact gateway
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/shelbyhost
EnvironmentFile=/etc/shelbyhost/gateway.env
ExecStart=/usr/bin/node --import tsx services/gateway/server.ts
Restart=always
RestartSec=5
User=shelby-gateway
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
